{
  "name": "@collab/collaboration",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Authenticated Hocuspocus/Yjs collaboration service",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@collab/contracts": "*",
    "@collab/db": "*",
    "@hocuspocus/extension-redis": "^2.15.3",
    "@hocuspocus/server": "^2.15.3",
    "dotenv": "^16.6.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@collab/config": "*",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "tsx": "^4.10.2",
    "typescript": "^5.4.5"
  }
}
