# ==============================================================================
# Collaborative Workspace Environment Configuration Template
# ==============================================================================

# Node Environment
NODE_ENV=development

# REST API Configuration
API_PORT=4000
DATABASE_URL=postgresql://collab:collab_secret@localhost:5433/collab_db?schema=public
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# Redis Configuration
REDIS_URL=redis://localhost:6380

# Collaboration WebSocket Server Configuration
COLLAB_PORT=4001
COLLAB_INSTANCE_ID=collab-1
COLLAB_ALLOWED_ORIGINS=http://localhost:3000

# Web Frontend Configuration
VITE_API_URL=http://localhost:4000
VITE_COLLAB_WS_URL=ws://localhost:4001
